# Copiar para .env apenas no ambiente de implementação. Nunca versionar segredos.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=America/Sao_Paulo
APP_MODE=real
DATABASE_PATH=./data/radar.sqlite3
# Token de plano gratuito, se necessário para ativos além dos exemplos públicos.
BRAPI_TOKEN=
# Executável instalado e autenticado pelo usuário. Não colocar credenciais aqui.
CODEX_BIN=codex
# Selecionar um modelo disponível na assinatura durante o setup; não adivinhar ID.
CODEX_MODEL=
AI_PROVIDER=codex_cli
AI_MAX_ANALYSES_PER_DAY=10
AI_CONCURRENCY=1
ALLOW_PAID_PROVIDERS=false
# Não adicionar OPENAI_API_KEY como fallback do login por assinatura.

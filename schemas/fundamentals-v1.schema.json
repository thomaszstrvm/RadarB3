{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed financial observations from one earnings release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_id",
    "review_status",
    "review_reference",
    "document_type",
    "issuer",
    "asset",
    "source",
    "publication",
    "accounting",
    "observations",
    "limitations",
    "mapping_version",
    "review_role"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mapping_id": {
      "const": "vale3-earnings-release-3t26-v1"
    },
    "review_status": {
      "const": "accepted_limited"
    },
    "review_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "document_type": {
      "const": "earnings_release"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "cnpj",
        "cvm_code",
        "registry_url"
      ],
      "properties": {
        "name": {
          "const": "Vale S.A."
        },
        "cnpj": {
          "const": "33.592.510/0001-54"
        },
        "cvm_code": {
          "const": "4170"
        },
        "registry_url": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "ticker",
        "isin",
        "identity_url"
      ],
      "properties": {
        "asset_id": {
          "const": "brapi:VALE3"
        },
        "ticker": {
          "const": "VALE3"
        },
        "isin": {
          "const": "BRVALEACNOR0"
        },
        "identity_url": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landing_url",
        "document_url",
        "pdf_sha256",
        "byte_length",
        "page_count",
        "fetched_at"
      ],
      "properties": {
        "landing_url": {
          "type": "string",
          "maxLength": 2000
        },
        "document_url": {
          "type": "string",
          "maxLength": 2000
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "page_count": {
          "const": 42
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "precision"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "precision": {
          "const": "date"
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "basis",
        "declaration_page"
      ],
      "properties": {
        "scope": {
          "const": "consolidated"
        },
        "basis": {
          "const": "IFRS_simplified_earnings_release"
        },
        "declaration_page": {
          "const": 20
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "mapping_version": {
      "const": "1.0"
    },
    "review_role": {
      "const": "development_agent_independent_review"
    }
  },
  "$defs": {
    "nullable_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "source_label",
        "value",
        "missing_reason",
        "currency",
        "scale",
        "period",
        "location"
      ],
      "properties": {
        "account": {
          "enum": [
            "net_sales_revenue",
            "net_income_attributable_to_vale_shareholders",
            "cash_and_cash_equivalents",
            "net_cash_from_operating_activities"
          ]
        },
        "source_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "currency": {
          "const": "USD"
        },
        "scale": {
          "const": 1000000
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source_label",
            "start",
            "end",
            "at",
            "normalization"
          ],
          "properties": {
            "kind": {
              "enum": [
                "quarter",
                "year_to_date",
                "instant"
              ]
            },
            "source_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "start": {
              "$ref": "#/$defs/nullable_date"
            },
            "end": {
              "$ref": "#/$defs/nullable_date"
            },
            "at": {
              "$ref": "#/$defs/nullable_date"
            },
            "normalization": {
              "enum": [
                "calendar_labels_v1",
                "literal_date"
              ]
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pdf_page",
            "printed_page",
            "table",
            "column"
          ],
          "properties": {
            "pdf_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 42
            },
            "printed_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 42
            },
            "table": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "column": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          }
        }
      }
    }
  }
}

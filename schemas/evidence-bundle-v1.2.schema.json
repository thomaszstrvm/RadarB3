    "technical_policy": {
      "type": "object",
      "properties": {
        "definition": {
          "const": {
            "policy_id": "technical_alignment_v1",
            "experimental": true,
            "formula": "M_n=(log(A_end)-log(A_start))/(sample_std(last20_log_A_returns)*sqrt(n))",
            "windows": [
              5,
              21
            ],
            "kappa": 1,
            "comparison": "strict_unrounded",
            "horizon_semantics": "conditional_hypothesis_reassessment",
            "horizons_days": [
              30,
              90
            ],
            "fundamentals_news_role": "context_not_votes",
            "limitations": [
              "no_predictive_calibration",
              "not_probability",
              "not_personalized",
              "not_investor_total_return",
              "no_growth_or_valuation_inference"

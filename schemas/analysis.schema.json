{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radar B3 AI analysis v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "supported_hypothesis",
        "inconclusive",
        "insufficient_data"
      ]
    },
    "synthesis": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "inference"
            ]
          },
          "statement": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "statement",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "string",
            "enum": [
              "conditional_case",
              "upside_case",
              "downside_case"
            ]
          },
          "horizon_days": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invalidation_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "case",
          "horizon_days",
          "description",
          "conditions",
          "invalidation_conditions",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "opportunity": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "investigate",
            "watch",
            "avoid_for_now",
            "insufficient_data"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "classification",
        "rationale",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "as_of",
    "asset_id",
    "status",
    "synthesis",
    "claims",
    "scenarios",
    "opportunity",
    "risks",
    "missing_evidence",
    "data_quality_flags",
    "evidence_ids"
  ],
  "additionalProperties": false
}
